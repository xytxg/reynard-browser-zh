    "Install the TrollStore version of Reynard to enable JIT automatically for improved performance and to ensure websites work properly." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když si nainstalujete verzi Reynardu pro TrollStore, JIT bude možno spustit automaticky, čímž se zlepší výkon aplikace a zajistí správné fungování stránek."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Install the TrollStore version of Reynard to enable JIT automatically for improved performance and to ensure websites work properly."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installer la version TrollStore de Reynard afin d'activer le JIT automatiquement pour améliorer les performances et s'assurer que les sites Web fonctionnent correctement."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動でJITを有効にするにはTrollStore版のReynardをインストールしてください。パフォーマンスの向上とサイトが正しく動作する事が期待できます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zainstaluj wersję Reynard dostępną w TrollStore, aby automatycznie włączyć JIT i poprawić wydajność, a także zapewnić prawidłowe działanie stron internetowych."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Установите версию Reynard для TrollStore, чтобы автоматически включать JIT, повысить производительность и обеспечить правильную обработку сайтов.\n"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安装 TrollStore 版 Reynard，即可自动启用 JIT，以提高性能并确保网站正常工作。"
          }
        }
      }
    },
