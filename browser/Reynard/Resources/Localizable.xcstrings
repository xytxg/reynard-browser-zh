    },
    "The downloaded IPA is unsigned. Choose AltStore, SideStore, or another compatible signing app in the share sheet to install it." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下载的 IPA 未签名，请在共享菜单中选择 AltStore、SideStore 或其他兼容签名 App 进行安装。"
          }
        }
      }
    },
    "The downloaded update failed SHA-256 verification." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下载的更新未通过 SHA-256 校验。"
