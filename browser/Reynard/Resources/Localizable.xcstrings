          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は無効です。設定を開いて許可してください"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ jest zablokowane dla Reynard. Otwórz Ustawienia, aby zezwolić na dostęp."
