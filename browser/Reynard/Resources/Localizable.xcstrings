        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voulez-vous autoriser %@ à accéder à d'autres applications et services sur cet appareil ?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@に端末上の他のアプリやサービスへのアクセスを許可しますか?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy zezwolić %@ na dostęp do innych aplikacji i usług na tym urządzeniu?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Разрешить %@ доступ к другим приложениям и службам на этом устройстве?\n"
          }
        },
        "zh-Hans" : {
