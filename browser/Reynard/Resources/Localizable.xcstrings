        }
      }
    },
    "No compatible Reynard IPA was found in recent releases." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最近的 Release 中没有找到兼容的 Reynard IPA。"
          }
        }
      }
    },
    "No TrollStore package is attached to this release. The verified unsigned IPA can still be downloaded and shared." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 Release 未附带 TrollStore 安装包，仍可下载并分享已校验的未签名 IPA。"
          }
        }
      }
    },
    "Reynard %@ is available to download." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reynard %@ 已可下载。"
