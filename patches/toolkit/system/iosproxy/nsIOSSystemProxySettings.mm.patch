+// [reynard-browser-zh] Proxy resolution notes
+//
+// This file is built without ARC, like the rest of Gecko.
+//
+// Gecko asks this component for every request on the PAC thread, so the work
+// here sits on the critical path of every page load:
+//  - A configuration with no proxy at all answers DIRECT without asking
+//    CFNetwork for a per-URL proxy list.
+//  - A PAC file is downloaded once (directly, never through the proxy it
+//    describes) and kept for a short time, instead of being fetched again by
+//    CFNetwork for every request. Its script then runs locally.
+//  - A PAC file that cannot be loaded, an entry CFNetwork reports without a
+//    host or port, or a proxy type Gecko does not understand no longer fails
+//    the whole lookup; the remaining entries are used, and DIRECT is the last
+//    resort, as Safari does.
+
+namespace {
+
+constexpr NSTimeInterval kPACScriptLifetime = 60;
+constexpr NSTimeInterval kPACFailureRetryDelay = 15;
+constexpr NSTimeInterval kPACFetchTimeout = 10;
+constexpr CFTimeInterval kPACRunTimeout = 15;
+
+mozilla::StaticMutex sPACCacheMutex MOZ_UNANNOTATED;
+NSString* sPACCacheURL = nil;
+NSString* sPACCacheScript = nil;
+NSDate* sPACCacheExpiry = nil;
+
+bool IsEnabled(NSDictionary* aSettings, CFStringRef aKey) {
+  id value = aSettings[(__bridge NSString*)aKey];
+  return [value isKindOfClass:[NSNumber class]] && [value boolValue];
+}
+
+// True when the system configuration names no proxy server, PAC file or PAC
+// script, so every request goes out directly.
+bool SettingsAreDirect(NSDictionary* aSettings) {
+  if (!aSettings) {
+    return true;
+  }
+  if (IsEnabled(aSettings, kCFNetworkProxiesHTTPEnable) ||
+      IsEnabled(aSettings, kCFNetworkProxiesProxyAutoConfigEnable)) {
+    return false;
+  }
+  // Keys iOS does not export as constants but can report for VPN and
+  // configuration-profile proxies.
+  for (NSString* key in @[ @"HTTPSEnable", @"SOCKSEnable",
+                           @"ProxyAutoConfigJavaScript" ]) {
+    id value = aSettings[key];
+    if ([value isKindOfClass:[NSNumber class]] && [value boolValue]) {
+      return false;
+    }
+    if ([value isKindOfClass:[NSString class]] && [value length] > 0) {
+      return false;
+    }
+  }
+  // Per-interface settings, such as those a VPN app installs for its tunnel.
+  id scoped = aSettings[@"__SCOPED__"];
+  if ([scoped isKindOfClass:[NSDictionary class]]) {
+    for (id interface in (NSDictionary*)scoped) {
+      id interfaceSettings = ((NSDictionary*)scoped)[interface];
+      if ([interfaceSettings isKindOfClass:[NSDictionary class]] &&
+          !SettingsAreDirect(interfaceSettings)) {
+        return false;
+      }
+    }
+  }
+  return true;
+}
+
+NSURLSession* PACSession() {
+  static NSURLSession* session = nil;
+  static dispatch_once_t once;
+  dispatch_once(&once, ^{
+    NSURLSessionConfiguration* config =
+        [NSURLSessionConfiguration ephemeralSessionConfiguration];
+    // The PAC file has to be reachable without the proxy it configures.
+    config.connectionProxyDictionary = @{};
+    config.requestCachePolicy = NSURLRequestReloadIgnoringLocalCacheData;
+    config.timeoutIntervalForRequest = kPACFetchTimeout;
+    config.timeoutIntervalForResource = kPACFetchTimeout;
+    session = [[NSURLSession sessionWithConfiguration:config] retain];
+  });
+  return session;
+}
+
+NSString* DownloadPACScript(NSURL* aURL) {
+  __block NSString* script = nil;
+  dispatch_semaphore_t done = dispatch_semaphore_create(0);
+  NSURLSessionDataTask* task = [PACSession()
+        dataTaskWithURL:aURL
+      completionHandler:^(NSData* data, NSURLResponse* response,
+                          NSError* error) {
+        NSInteger status = 200;
+        if ([response isKindOfClass:[NSHTTPURLResponse class]]) {
+          status = ((NSHTTPURLResponse*)response).statusCode;
+        }
+        if (!error && data.length > 0 && status >= 200 && status < 300) {
+          script = [[NSString alloc] initWithData:data
+                                         encoding:NSUTF8StringEncoding];
+          if (!script) {
+            script = [[NSString alloc] initWithData:data
+                                           encoding:NSISOLatin1StringEncoding];
+          }
+        }
+        dispatch_semaphore_signal(done);
+      }];
+  [task resume];
+  dispatch_time_t deadline = dispatch_time(
+      DISPATCH_TIME_NOW, (int64_t)((kPACFetchTimeout + 2) * NSEC_PER_SEC));
+  bool finished = dispatch_semaphore_wait(done, deadline) == 0;
+  dispatch_release(done);
+  if (!finished) {
+    // The handler may still run later; it then owns and leaks one string.
+    [task cancel];
+    return nil;
+  }
+  return [script autorelease];
+}
+
+// Returns the PAC script behind aURL, from the cache while it is fresh. A
+// failed download is remembered briefly so a dead PAC server does not stall
+// every request for the full fetch timeout.
+NSString* CachedPACScript(NSURL* aURL) {
+  NSString* key = aURL.absoluteString;
+  {
+    mozilla::StaticMutexAutoLock lock(sPACCacheMutex);
+    if ([sPACCacheURL isEqualToString:key] && sPACCacheExpiry &&
+        [sPACCacheExpiry timeIntervalSinceNow] > 0) {
+      return [[sPACCacheScript retain] autorelease];
+    }
+  }
+
+  NSString* script = DownloadPACScript(aURL);
+
+  mozilla::StaticMutexAutoLock lock(sPACCacheMutex);
+  [sPACCacheURL release];
+  sPACCacheURL = [key copy];
+  [sPACCacheScript release];
+  sPACCacheScript = [script retain];
+  [sPACCacheExpiry release];
+  sPACCacheExpiry = [[NSDate alloc]
+      initWithTimeIntervalSinceNow:script ? kPACScriptLifetime
+                                          : kPACFailureRetryDelay];
+  return script;
+}
+
+CFTypeRefPtr<CFArrayRef> RunPACScript(NSString* aScript, NSURL* aURL) {
+  CFTypeRefPtr<CFArrayRef> result;
+  if (!aScript.length) {
+    return result;
+  }
+
+  CFStreamClientContext context = {0, &result, nullptr, nullptr, nullptr};
+  auto callback = [](void* aContext, CFArrayRef aProxies, CFErrorRef aError) {
+    if (aProxies && !aError) {
+      static_cast<CFTypeRefPtr<CFArrayRef>*>(aContext)->AssignUnderGetRule(
+          aProxies);
+    }
+
+    CFRunLoopStop(CFRunLoopGetCurrent());
+  };
+
+  CFRunLoopSourceRef source = CFNetworkExecuteProxyAutoConfigurationScript(
+      (__bridge CFStringRef)aScript, (__bridge CFURLRef)aURL, callback,
+      &context);
+  if (!source) {
+    return result;
+  }
+
+  auto runLoopSource =
+      CFTypeRefPtr<CFRunLoopSourceRef>::WrapUnderCreateRule(source);
+  CFStringRef mode = CFSTR("ReynardProxyResolution");
+  CFRunLoopAddSource(CFRunLoopGetCurrent(), source, mode);
+
+  CFRunLoopRunInMode(mode, kPACRunTimeout, false);
+  CFRunLoopRemoveSource(CFRunLoopGetCurrent(), source, mode);
+  CFRunLoopSourceInvalidate(source);
+  return result;
+}
+
+CFTypeRefPtr<CFArrayRef> ResolveAutoConfigProxy(NSDictionary* aProxy,
+                                                NSURL* aURL) {
+  NSString* script = nil;
+  if ([aProxy[(__bridge NSString*)kCFProxyTypeKey]
+          isEqual:(__bridge NSString*)kCFProxyTypeAutoConfigurationURL]) {
+    id pacURL = aProxy[(__bridge NSString*)kCFProxyAutoConfigurationURLKey];
+    if ([pacURL isKindOfClass:[NSString class]]) {
+      pacURL = [NSURL URLWithString:pacURL];
+    }
+    if ([pacURL isKindOfClass:[NSURL class]]) {
+      script = CachedPACScript(pacURL);
+    }
+  } else {
+    id value =
+        aProxy[(__bridge NSString*)kCFProxyAutoConfigurationJavaScriptKey];
+    if ([value isKindOfClass:[NSString class]]) {
+      script = value;
+    }
+  }
+  return RunPACScript(script, aURL);
+}
+
+// CFNetwork only knows proxies for the schemes it fetches itself.
+NSString* SchemeForProxyLookup(const nsACString& aScheme) {
+  if (aScheme.EqualsLiteral("ws")) {
+    return @"http";
+  }
+  if (aScheme.EqualsLiteral("wss")) {
+    return @"https";
+  }
+  return [NSString stringWithUTF8String:PromiseFlatCString(aScheme).get()];
+}
+
+void AppendEntry(nsACString& aResult, const char* aEntry) {
+  if (!aResult.IsEmpty()) {
+    aResult.AppendLiteral("; ");
+  }
+  aResult.Append(aEntry);
+}
+
+}  // namespace
+
+class nsIOSSystemProxySettings final : public nsISystemProxySettings {
+ public:
+  NS_DECL_THREADSAFE_ISUPPORTS
+  NS_DECL_NSISYSTEMPROXYSETTINGS
+
+ private:
+  ~nsIOSSystemProxySettings() = default;
+};
