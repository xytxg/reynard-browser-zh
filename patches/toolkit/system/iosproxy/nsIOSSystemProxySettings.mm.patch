+NS_IMETHODIMP
+nsIOSSystemProxySettings::SetSystemProxyInfo(
+    const nsACString& aHost, int32_t aPort, const nsACString& aPacFileUrl,
+    const nsTArray<nsCString>& aExclusionList) {
+  return NS_ERROR_NOT_IMPLEMENTED;
+}
