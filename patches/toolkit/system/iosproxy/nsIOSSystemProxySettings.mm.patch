+NS_IMETHODIMP
+nsIOSSystemProxySettings::GetMainThreadOnly(bool* aMainThreadOnly) {
+  *aMainThreadOnly = false;
+  return NS_OK;
+}
+
+NS_IMETHODIMP
+nsIOSSystemProxySettings::GetPACURI(nsACString& aResult) {
+  aResult.Truncate();
+  return NS_OK;
+}
+
+NS_IMETHODIMP
+nsIOSSystemProxySettings::GetProxyForURI(const nsACString& aSpec,
+                                         const nsACString& aScheme,
+                                         const nsACString& aHost, int32_t aPort,
+                                         nsACString& aResult) {
+  aResult.Truncate();
+
+  @autoreleasepool {
+    auto settings = CFTypeRefPtr<CFDictionaryRef>::WrapUnderCreateRule(
+        CFNetworkCopySystemProxySettings());
+    if (SettingsAreDirect((__bridge NSDictionary*)settings.get())) {
+      aResult.AssignLiteral("DIRECT");
+      return NS_OK;
+    }
+
+    NSString* spec =
+        [NSString stringWithUTF8String:PromiseFlatCString(aSpec).get()];
+    NSURLComponents* components = spec
+                                      ? [NSURLComponents componentsWithString:spec]
+                                      : nil;
+    components.scheme = SchemeForProxyLookup(aScheme);
+    NSURL* url = components.URL;
+    if (!url) {
+      aResult.AssignLiteral("DIRECT");
+      return NS_OK;
+    }
+
+    auto systemProxies = CFTypeRefPtr<CFArrayRef>::WrapUnderCreateRule(
+        CFNetworkCopyProxiesForURL((__bridge CFURLRef)url, settings.get()));
+    NSMutableArray* proxies = [NSMutableArray array];
+    for (NSDictionary* proxy in (__bridge NSArray*)systemProxies.get()) {
+      NSString* type = proxy[(__bridge NSString*)kCFProxyTypeKey];
+      if ([type isEqual:(__bridge NSString*)kCFProxyTypeAutoConfigurationURL] ||
+          [type isEqual:(__bridge NSString*)
+                            kCFProxyTypeAutoConfigurationJavaScript]) {
+        auto resolved = ResolveAutoConfigProxy(proxy, url);
+        if (resolved) {
+          [proxies addObjectsFromArray:(__bridge NSArray*)resolved.get()];
+        }
+      } else {
+        [proxies addObject:proxy];
+      }
+    }
+
+    for (NSDictionary* proxy in proxies) {
+      if (![proxy isKindOfClass:[NSDictionary class]]) {
+        continue;
+      }
+      NSString* type = proxy[(__bridge NSString*)kCFProxyTypeKey];
+      if ([type isEqual:(__bridge NSString*)kCFProxyTypeNone]) {
+        AppendEntry(aResult, "DIRECT");
+        continue;
+      }
+
+      const char* proxyType;
+      if ([type isEqual:(__bridge NSString*)kCFProxyTypeHTTP] ||
+          [type isEqual:(__bridge NSString*)kCFProxyTypeHTTPS]) {
+        proxyType = "PROXY";
+      } else if ([type isEqual:(__bridge NSString*)kCFProxyTypeSOCKS]) {
+        proxyType = "SOCKS5";
+      } else {
+        continue;
+      }
+
+      id host = proxy[(__bridge NSString*)kCFProxyHostNameKey];
+      id port = proxy[(__bridge NSString*)kCFProxyPortNumberKey];
+      if (![host isKindOfClass:[NSString class]] || ![host length] ||
+          ![port isKindOfClass:[NSNumber class]]) {
+        continue;
+      }
+      int portValue = [port intValue];
+      if (portValue <= 0 || portValue > 65535) {
+        continue;
+      }
+
+      bool ipv6 = [host rangeOfString:@":"].location != NSNotFound &&
+                  ![host hasPrefix:@"["];
+      nsAutoCString entry;
+      entry.AppendPrintf("%s %s%s%s:%d", proxyType, ipv6 ? "[" : "",
+                         [host UTF8String], ipv6 ? "]" : "", portValue);
+      AppendEntry(aResult, entry.get());
+    }
+  }
+
+  if (aResult.IsEmpty()) {
+    aResult.AssignLiteral("DIRECT");
+  }
+  return NS_OK;
+}
+
+NS_IMETHODIMP
+nsIOSSystemProxySettings::GetSystemWPADSetting(bool* aSystemWPADSetting) {
+  *aSystemWPADSetting = false;
+  return NS_OK;
+}
+
+NS_IMETHODIMP
+nsIOSSystemProxySettings::GetSystemProxyDirect(bool* aResult) {
+  @autoreleasepool {
+    auto settings = CFTypeRefPtr<CFDictionaryRef>::WrapUnderCreateRule(
+        CFNetworkCopySystemProxySettings());
+    *aResult = SettingsAreDirect((__bridge NSDictionary*)settings.get());
+  }
+  return NS_OK;
+}
